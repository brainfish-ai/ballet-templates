{
  "name": "@brainfish-ai/ballet-templates",
  "version": "0.1.1",
  "description": "Importable Ballet playbook templates for support, sales, ops and MCP workflows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainfish-ai/ballet-templates.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "templates/",
    "catalog.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate.mjs && node scripts/build.mjs --check",
    "sync": "node scripts/sync-repos.mjs",
    "publish:shares": "node scripts/publish-shares.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  }
