---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import AppGlyph from '../../components/AppGlyph.astro';
import {
  formatIntegration,
  getAllTemplates,
  type TemplateDetail,
} from '../../lib/templates';

export function getStaticPaths() {
  return getAllTemplates().map(t => ({
    params: { id: t.id },
    props: { template: t },
  }));
}

interface Props {
  template: TemplateDetail;
}

const { template } = Astro.props;
const shareUrl = `https://templates.ballet.dev/templates/${template.id}/`;

function humanizeStepId(id: string): string {
  return id
    .replace(/[_-]+/g, ' ')
    .replace(/\b\w/g, c => c.toUpperCase());
}

function formatCallTitle(call: { kind: string; title: string }): string {
  if (call.kind === 'agents') return humanizeStepId(call.title);
  return call.title;
}

const primaryIntegration = template.integrations[0];
const triggerTitle = primaryIntegration
  ? formatIntegration(primaryIntegration)
  : template.triggerKind === 'webhook'
    ? 'Webhook'
    : template.triggerKind === 'schedule'
      ? 'Schedule'
      : 'Manual run';

const triggerSubtitle = primaryIntegration && template.triggerKind === 'webhook'
  ? `Runs when ${formatIntegration(primaryIntegration)} sends an event`
  : template.trigger;

const hasNeeds = template.secretSpecs.length > 0 || template.mcpServerSpecs.length > 0;

const pageTitle = template.seoTitle || template.title;
const pageDescription = template.answer || template.summary;

function deriveWhatYouNeed(): string[] {
  if (template.whatYouNeed) return [template.whatYouNeed];
  const needs: string[] = [];
  if (template.integrations.length > 0) {
    needs.push(template.integrations.map(formatIntegration).join(', ') + ' account' + (template.integrations.length > 1 ? 's' : ''));
  }
  if (template.secretSpecs.length > 0) {
    needs.push(template.secretSpecs.map(s => s.name).join(', '));
  }
  if (template.mcpServerSpecs.length > 0) {
    needs.push(template.mcpServerSpecs.map(m => m.name || m.id).join(', '));
  }
  return needs;
}

const whatYouNeedList = deriveWhatYouNeed();

function getStepLabel(step: typeof template.workflowSteps[0]): string {
  const hasAgent = step.calls.some(c => c.kind === 'agents');
  if (hasAgent) return 'AI agent';
  if (step.type === 'code') return 'Code (deterministic)';
  return 'Code (deterministic)';
}

const jsonLd = {
  breadcrumb: {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Templates",
        "item": "https://templates.ballet.dev/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": template.useCaseLabel,
        "item": `https://templates.ballet.dev/?category=${template.useCase}`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": pageTitle,
        "item": shareUrl
      }
    ]
  },
  faq: template.faq && template.faq.length > 0 ? {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": template.faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  } : null,
  howTo: {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": pageTitle,
    "description": pageDescription,
    "step": template.workflowSteps.map((step, idx) => ({
      "@type": "HowToStep",
      "position": idx + 1,
      "name": humanizeStepId(step.id),
      "text": step.description
    }))
  },
  sourceCode: {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    "codeRepository": "https://github.com/brainfish-ai/ballet-templates",
    "programmingLanguage": "TypeScript",
    "name": pageTitle,
    "description": pageDescription,
    "dateModified": template.lastValidated || new Date().toISOString().split('T')[0]
  },
  softwareApp: {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Ballet",
    "applicationCategory": "BusinessApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }
};
---

<Base
  title={`${pageTitle} | Ballet Templates`}
  description={pageDescription}
>
  <Fragment slot="head">
    <meta property="og:title" content={`${pageTitle} | Ballet Templates`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={shareUrl} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${pageTitle} | Ballet Templates`} />
    <meta name="twitter:description" content={pageDescription} />
    
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd.breadcrumb)} />
    {jsonLd.faq && <script type="application/ld+json" set:html={JSON.stringify(jsonLd.faq)} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd.howTo)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd.sourceCode)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd.softwareApp)} />
  </Fragment>

  <SiteHeader showBackToCatalog />

  <main id="main" class="detail-main">
    <div class="wrap detail-wrap">
      <header class="detail-header">
        <p class="detail-eyebrow">
          <a href={`/?category=${template.useCase}#catalog`} class="eyebrow-link">
            {template.useCaseLabel}
          </a>
          <span class="eyebrow-sep">/</span>
          <span>Import template</span>
        </p>

        <h1 class="detail-h1">{pageTitle}</h1>
        
        {template.answer && (
          <p class="answer-paragraph">{template.answer}</p>
        )}
        
        {whatYouNeedList.length > 0 && (
          <aside class="what-you-need-box">
            <h2 class="wyn-heading">What you need</h2>
            <ul class="wyn-list">
              {whatYouNeedList.map(item => (
                <li>{item}</li>
              ))}
              {template.setupMinutes && (
                <li>Setup time: ~{template.setupMinutes} minutes</li>
              )}
            </ul>
          </aside>
        )}
      </header>

      {template.workflowSteps.length > 0 && (
        <section class="numbered-steps-section">
          <h2 class="section-h2">How it works</h2>
          <ol class="numbered-steps-list">
            {template.workflowSteps.map((step) => (
              <li class="numbered-step">
                <div class="step-header">
                  <h3 class="step-title">{humanizeStepId(step.id)}</h3>
                  <span class="step-label">{getStepLabel(step)}</span>
                </div>
                <p class="step-description">{step.description}</p>
                {step.calls.filter(c => c.kind !== 'http' && c.kind !== 'secret').length > 0 && (
                  <div class="step-calls">
                    {step.calls.filter(c => c.kind !== 'http' && c.kind !== 'secret').map(call => (
                      <span class="step-call-chip">
                        <Icon
                          name={
                            call.kind === 'agents'
                              ? 'sparkle'
                              : call.kind === 'mcp'
                                ? 'plugs-connected'
                                : 'wrench'
                          }
                          size={11}
                        />
                        {formatCallTitle(call)}
                      </span>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}

      {template.sampleOutput && (
        <section class="sample-output-section">
          <h2 class="section-h2">Sample output</h2>
          <pre class="sample-output-block">{template.sampleOutput}</pre>
        </section>
      )}

      {template.failureHandling && (
        <section class="failure-handling-section">
          <h2 class="section-h2">What happens when something fails</h2>
          <p class="failure-text">{template.failureHandling}</p>
        </section>
      )}

      {template.nativeVsTemplate && (
        <section class="native-vs-section">
          <h2 class="section-h2">When the built-in feature is enough</h2>
          <p class="native-vs-text">{template.nativeVsTemplate}</p>
        </section>
      )}

      <section class="comparison-table-section">
        <h2 class="section-h2">Ballet vs. alternatives for this workflow</h2>
        <div class="comparison-table-wrap">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th>Ballet</th>
                <th>Zapier</th>
                <th>n8n</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Versioned code steps</td>
                <td><Icon name="check" size={16} /></td>
                <td><Icon name="x" size={16} /></td>
                <td><Icon name="check" size={16} /></td>
              </tr>
              <tr>
                <td>Deterministic vs AI steps labelled</td>
                <td><Icon name="check" size={16} /></td>
                <td><Icon name="x" size={16} /></td>
                <td><Icon name="x" size={16} /></td>
              </tr>
              <tr>
                <td>Human approval step</td>
                <td><Icon name="check" size={16} /></td>
                <td><Icon name="minus" size={16} /></td>
                <td><Icon name="check" size={16} /></td>
              </tr>
              <tr>
                <td>Run history and rollback</td>
                <td><Icon name="check" size={16} /></td>
                <td><Icon name="check" size={16} /></td>
                <td><Icon name="check" size={16} /></td>
              </tr>
              <tr>
                <td>Test before deploy</td>
                <td><Icon name="check" size={16} /></td>
                <td><Icon name="minus" size={16} /></td>
                <td><Icon name="check" size={16} /></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      {template.faq && template.faq.length > 0 && (
        <section class="faq-section">
          <h2 class="section-h2">Frequently asked questions</h2>
          <dl class="faq-list">
            {template.faq.map(item => (
              <div class="faq-item">
                <dt class="faq-question">{item.q}</dt>
                <dd class="faq-answer">{item.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <section class="cta-section">
        <div class="cta-box">
          <h2 class="cta-heading">Ready to automate this workflow?</h2>
          <p class="cta-text">Import this template to your Ballet workspace and start running it in minutes. Free trial, no credit card required.</p>
          <div class="cta-actions">
            <a href={template.primaryCtaUrl} target="_blank" rel="noopener" class="btn-cta-primary">
              <Icon name="download-simple" size={16} />
              Import this template
            </a>
            <a href="https://app.ballet.dev/signup" target="_blank" rel="noopener" class="btn-cta-secondary">
              Start free trial
            </a>
          </div>
        </div>
      </section>

      {template.related && template.related.length > 0 && (
        <section class="related-section">
          <h2 class="section-h2">Related templates</h2>
          <ul class="related-list">
            {template.related.map(relatedId => {
              const related = getAllTemplates().find(t => t.id === relatedId);
              return related ? (
                <li class="related-item">
                  <a href={`/templates/${related.id}/`} class="related-link">
                    <strong class="related-title">{related.title}</strong>
                    <p class="related-summary">{related.summary}</p>
                  </a>
                </li>
              ) : null;
            })}
          </ul>
        </section>
      )}

      {template.lastValidated && 
        <footer class="template-footer" data-astro-cid-lxz2y7y6>
          <p class="validation-note" data-astro-cid-lxz2y7y6>
            Last validated {template.lastValidated} by the Brainfish team
          </p>
        </footer>
      }

      <div class="detail-grid" data-astro-cid-lxz2y7y6>
        <!-- Left Column: How it works -->
        <section class="detail-left">
          <div class="section-head">
            <h2>How it works</h2>
          </div>

          <div class="flow-canvas">
            <div class="flow-node trigger-node">
              <div class="node-head">
                <span class="node-icon" aria-hidden="true">
                  {primaryIntegration ? (
                    <AppGlyph app={primaryIntegration} size={16} />
                  ) : (
                    <Icon
                      name={
                        template.triggerKind === 'webhook'
                          ? 'webhooks-logo'
                          : template.triggerKind === 'schedule'
                            ? 'clock'
                            : 'play'
                      }
                      size={15}
                    />
                  )}
                </span>
                <div class="node-copy">
                  <div class="node-title-row">
                    <strong class="node-title">{triggerTitle}</strong>
                  </div>
                  <p class="node-desc">{triggerSubtitle}</p>
                </div>
              </div>
            </div>

            {template.workflowSteps.map(step => {
              const visibleCalls = step.calls.filter(c => c.kind !== 'http' && c.kind !== 'secret');
              return (
                <div class="node-connector-wrap">
                  <div class="node-connector" aria-hidden="true">
                    <span class="node-dot"></span>
                  </div>
                  <article class="flow-node">
                    <div class="node-head">
                      <span class="node-circle" aria-hidden="true"></span>
                      <div class="node-copy">
                        <div class="node-title-row">
                          <strong class="node-title">{humanizeStepId(step.id)}</strong>
                        </div>
                        <p class="node-desc">{step.description}</p>
                        {visibleCalls.length > 0 && (
                          <div class="node-chips">
                            {visibleCalls.map(call => (
                              <span class="node-chip">
                                <Icon
                                  name={
                                    call.kind === 'agents'
                                      ? 'sparkle'
                                      : call.kind === 'mcp'
                                        ? 'plugs-connected'
                                        : 'wrench'
                                  }
                                  size={12}
                                />
                                {formatCallTitle(call)}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </article>
                </div>
              );
            })}
          </div>
        </section>

        <!-- Right Column: Integrations, Models, What you will need, Setup -->
        <aside class="detail-aside">
          {template.integrations.length > 0 && (
            <section class="aside-section">
              <h2 class="aside-heading">Integrations required</h2>
              <ul class="chip-list">
                {template.integrations.map(intg => (
                  <li class="spec-chip">
                    <AppGlyph app={intg} size={14} />
                    <span>{formatIntegration(intg)}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {template.modelLabel && (
            <section class="aside-section">
              <h2 class="aside-heading">Models used</h2>
              <ul class="chip-list">
                <li class="spec-chip">
                  {template.modelProvider ? (
                    <img
                      src={`/assets/models/${template.modelProvider}.avif`}
                      alt=""
                      width="14"
                      height="14"
                      class="model-provider-icon"
                    />
                  ) : (
                    <Icon name="sparkle" size={14} />
                  )}
                  <span>{template.modelLabel}</span>
                </li>
              </ul>
            </section>
          )}

          {hasNeeds && (
            <section class="aside-section">
              <h2 class="aside-heading">What you will need</h2>
              <ul class="grouped-list">
                {template.secretSpecs.map(secret => (
                  <li class="req-row">
                    <span class="req-icon" aria-hidden="true">
                      <Icon name="key" size={14} />
                    </span>
                    <div class="req-body">
                      <p class="req-name is-mono">{secret.name}</p>
                      {secret.description && <p class="req-detail">{secret.description}</p>}
                    </div>
                    <button
                      type="button"
                      class="req-status js-copy-text"
                      data-copy={secret.name}
                      data-toast={`Copied ${secret.name}`}
                      title={`Copy ${secret.name}`}
                    >
                      <Icon name="circle-dashed" size={13} />
                      <span>Add after import</span>
                    </button>
                  </li>
                ))}
                {template.mcpServerSpecs.map(mcp => (
                  <li class="req-row">
                    <span class="req-icon" aria-hidden="true">
                      <Icon name="plugs-connected" size={14} />
                    </span>
                    <div class="req-body">
                      <p class="req-name">{mcp.name ?? mcp.id}</p>
                      <p class="req-detail">{mcp.transport ? `MCP server (${mcp.transport})` : 'MCP server'}</p>
                    </div>
                    <span class="req-status">
                      <Icon name="circle-dashed" size={13} />
                      <span>Connect after import</span>
                    </span>
                  </li>
                ))}
              </ul>
              <p class="aside-footnote">
                Secret values never leave your workspace. Importing does not publish the playbook or turn on any webhook.
              </p>
            </section>
          )}

          {template.setup.length > 0 && (
            <section class="aside-section">
              <h2 class="aside-heading">Setup</h2>
              <ol class="grouped-list setup-ol">
                {template.setup.map((line, index) => (
                  <li class="setup-row">
                    <span class="setup-num">{index + 1}</span>
                    <span class="setup-text">{line}</span>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {template.notes.length > 0 && (
            <section class="aside-section">
              <h2 class="aside-heading">Notes</h2>
              <ul class="notes-list">
                {template.notes.map(note => (
                  <li>{note}</li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </div>
  </main>

  <!-- Sticky Bottom Action Bar matching app.ballet.dev/import -->
  <div class="sticky-bar">
    <div class="wrap sticky-bar-inner">
      <p class="sticky-note">
        Create a free account to add this to your workspace.
        <a href={template.githubUrl} target="_blank" rel="noopener" class="sticky-source-link">
          <Icon name="github-logo" size={14} />
          <span>View source (brainfish-ai/ballet-templates)</span>
        </a>
      </p>

      <div class="sticky-actions">
        <button
          type="button"
          class="btn-outline js-copy-current"
          data-copy={shareUrl}
          data-toast="Share link copied"
        >
          <Icon name="link" size={15} />
          Copy link
        </button>
        <a href={template.primaryCtaUrl} target="_blank" rel="noopener" class="btn-ink">
          <Icon name="download-simple" size={15} />
          Import this template
        </a>
      </div>
    </div>
  </div>

  <SiteFooter compact />
</Base>

<style>
  .detail-main {
    position: relative;
    padding-bottom: 48px;
  }

  .detail-wrap {
    padding-top: 12px;
  }

  .detail-header {
    max-width: 820px;
    margin-bottom: 28px;
  }

  .detail-eyebrow {
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-2);
  }

  .eyebrow-link {
    color: var(--brand-soft);
  }

  .eyebrow-link:hover {
    text-decoration: underline;
  }

  .detail-h1 {
    margin: 0 0 16px;
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.18;
    color: var(--ink);
  }

  .detail-summary {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }

  .answer-paragraph {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
    max-width: 820px;
  }

  .what-you-need-box {
    margin: 0 0 32px;
    padding: 16px 20px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    max-width: 820px;
  }

  .wyn-heading {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  .wyn-list {
    margin: 0;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    display: grid;
    gap: 6px;
  }

  .section-h2 {
    margin: 0 0 16px;
    font-size: clamp(1.3rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
  }

  .numbered-steps-section {
    margin-bottom: 40px;
    max-width: 820px;
  }

  .numbered-steps-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step-counter;
    display: grid;
    gap: 16px;
  }

  .numbered-step {
    position: relative;
    padding-left: 48px;
    counter-increment: step-counter;
  }

  .numbered-step::before {
    content: counter(step-counter);
    position: absolute;
    left: 0;
    top: 2px;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 2px solid var(--brand-soft);
    background: var(--surface);
    color: var(--brand-soft);
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .step-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }

  .step-label {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .step-description {
    margin: 0 0 8px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--muted);
  }

  .step-calls {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .step-call-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border-radius: 5px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--ink);
  }

  .sample-output-section,
  .failure-handling-section,
  .native-vs-section {
    margin-bottom: 40px;
    max-width: 820px;
  }

  .sample-output-block {
    margin: 0;
    padding: 16px 18px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink);
    overflow-x: auto;
    white-space: pre-wrap;
  }

  .failure-text,
  .native-vs-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .comparison-table-section {
    margin-bottom: 40px;
    max-width: 820px;
  }

  .comparison-table-wrap {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
