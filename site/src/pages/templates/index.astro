---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';
import AppGlyph from '../../components/AppGlyph.astro';
import {
  getAllTemplates,
  USE_CASES,
  formatIntegration,
  type TemplateDetail,
} from '../../lib/templates';

const templates = getAllTemplates();

const templatesByUseCase = new Map<string, TemplateDetail[]>();
USE_CASES.forEach(uc => {
  templatesByUseCase.set(uc.id, []);
});

templates.forEach(t => {
  const group = templatesByUseCase.get(t.useCase);
  if (group) {
    group.push(t);
  } else {
    const fallback = templatesByUseCase.get('data-management');
    if (fallback) fallback.push(t);
  }
});

const pageTitle = 'Ballet Workflow Templates';
const pageDescription = 'Pre-built automation playbooks for lead management, customer support, sales pipeline, marketing campaigns, and more. Import to Ballet and run instantly.';
---

<Base
  title={`${pageTitle} | Ballet`}
  description={pageDescription}
>
  <Fragment slot="head">
    <meta property="og:title" content={`${pageTitle} | Ballet`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://templates.ballet.dev/templates/" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${pageTitle} | Ballet`} />
    <meta name="twitter:description" content={pageDescription} />
  </Fragment>

  <SiteHeader />

  <main id="main" class="hub-main">
    <div class="wrap hub-wrap">
      <header class="hub-header">
        <h1 class="hub-h1">Ballet Workflow Templates</h1>
        <p class="hub-intro">
          Pre-built automation playbooks for lead management, customer support, sales pipeline, marketing campaigns, and more. Each template includes AI agents, integrations, and step-by-step workflow logic. Import to Ballet and run instantly—no code required.
        </p>
      </header>

      {USE_CASES.map(useCase => {
        const group = templatesByUseCase.get(useCase.id) || [];
        if (group.length === 0) return null;
        
        return (
          <section class="use-case-section">
            <div class="use-case-head">
              <div class="use-case-icon-wrap" style={`background: ${useCase.accent}15; color: ${useCase.accent}`}>
                <Icon name={useCase.icon as any} size={20} />
              </div>
              <h2 class="use-case-h2">{useCase.label}</h2>
            </div>
            
            <div class="template-grid">
              {group.map(template => (
                <a href={`/templates/${template.id}/`} class="template-card">
                  <div class="card-header">
                    <h3 class="card-title">{template.title}</h3>
                    {template.integrations.length > 0 && (
                      <div class="card-integrations">
                        {template.integrations.slice(0, 3).map(intg => (
                          <span class="integration-badge">
                            <AppGlyph app={intg} size={14} />
                          </span>
                        ))}
                        {template.integrations.length > 3 && (
                          <span class="integration-more">+{template.integrations.length - 3}</span>
                        )}
                      </div>
                    )}
                  </div>
                  
                  {template.answer ? (
                    <p class="card-answer">{template.answer}</p>
                  ) : (
                    <p class="card-summary">{template.summary}</p>
                  )}
                  
                  <div class="card-footer">
                    {template.setupMinutes && (
                      <span class="card-meta">
                        <Icon name="clock" size={13} />
                        ~{template.setupMinutes} min setup
                      </span>
                    )}
                    <span class="card-meta">
                      <Icon name="arrow-right" size={13} />
                      View template
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })}

      <section class="cta-section">
        <div class="cta-box">
          <h2 class="cta-heading">Ready to automate your workflows?</h2>
          <p class="cta-text">Import any template to your Ballet workspace and start running it in minutes. Free trial, no credit card required.</p>
          <div class="cta-actions">
            <a href="https://app.ballet.dev/signup" target="_blank" rel="noopener" class="btn-cta-primary">
              <Icon name="rocket" size={16} />
              Start free trial
            </a>
            <a href="https://ballet.dev" target="_blank" rel="noopener" class="btn-cta-secondary">
              Learn more about Ballet
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  .hub-main {
    padding: 32px 0 64px;
  }

  .hub-wrap {
    max-width: 1200px;
  }

  .hub-header {
    text-align: center;
    margin-bottom: 48px;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }

  .hub-h1 {
    margin: 0 0 16px;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }

  .hub-intro {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }

  .use-case-section {
    margin-bottom: 56px;
  }

  .use-case-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .use-case-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .use-case-h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.2vw, 1.65rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .template-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }

  @media (max-width: 720px) {
    .template-grid {
      grid-template-columns: 1fr;
    }
  }

  .template-card {
    display: flex;
    flex-direction: column;
    padding: 20px 22px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    transition: all 0.2s ease;
    min-height: 180px;
  }

  .template-card:hover {
    border-color: var(--brand-soft);
    box-shadow: 0 4px 12px rgba(27, 22, 49, 0.06);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .card-title {
    flex: 1;
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .card-integrations {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .integration-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    border: 1px solid var(--line);
    background: var(--paper-2);
  }

  .integration-more {
    font-size: 11px;
    font-weight: 600;
    color: var(--muted-2);
    padding-left: 4px;
  }

  .card-answer {
    flex: 1;
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-summary {
    flex: 1;
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }

  .card-meta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted-2);
  }

  .card-meta:last-child {
    margin-left: auto;
    color: var(--brand-soft);
  }

  .cta-section {
    margin-top: 64px;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-box {
    padding: 32px 36px;
    border-radius: 14px;
    border: 2px solid var(--brand-soft);
    background: linear-gradient(135deg, var(--surface) 0%, var(--paper-2) 100%);
    text-align: center;
  }

  .cta-heading {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
  }

  .cta-text {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 8px;
    background: var(--ink);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .btn-cta-primary:hover {
    transform: translateY(-1px);
  }

  .btn-cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    border-radius: 8px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-cta-secondary:hover {
    border-color: var(--ink);
  }
</style>
